@endpoint = http://localhost:3000/api/v1

###

### logging in 

POST {{endpoint}}/auth/register HTTP/3.0
Content-Type: application/json

{
    "name":"michael",
    "email":"private@example.com",
    "password":"SuperSecret Password"
}

### log michael in
# @name login
POST {{endpoint}}/auth/login HTTP/3.0
Content-Type: application/json

{
    "email":"private@example.com",
    "password":"SuperSecret Password"
}
###

POST {{endpoint}}/auth/register HTTP/3.0
Content-Type: application/json

{
    "name":"UNA",
    "email":"privateUna@example.com",
    "password":"SuperDuperSecret Password"
}

### log una in 
# @name login
POST {{endpoint}}/auth/login HTTP/3.0
Content-Type: application/json

{
    "email":"privateUna@example.com",
    "password":"SuperDuperSecret Password"
}
###

@accessToken = {{login.response.body.token}}
DELETE {{endpoint}}/cars/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

###

GET {{endpoint}}/auth/me HTTP/1.1
Authorization: Bearer {{accessToken}}
